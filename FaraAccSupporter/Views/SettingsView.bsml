<settings-container>
  <horizontal>
    <text text="FaraAccSupporter Settings" font-size="5" align="Center"/>
  </horizontal>

  <toggle-setting text="Enabled"
                  value="enabled"
                  apply-on-change="true"
                  hover-hint="Enable or disable the acc supporter mod"/>

  <horizontal>
    <text text="Pre-Swing Feedback (70pts)" font-size="4"/>
  </horizontal>

  <toggle-setting text="Note Glow"
                  value="pre-swing-glow"
                  apply-on-change="true"
                  hover-hint="Glow the target note when pre-swing (70pts) threshold is reached"/>

  <horizontal>
    <text text="Follow-Through Feedback (30pts)" font-size="4"/>
  </horizontal>

  <toggle-setting text="Vibration Enabled"
                  value="vibration-enabled"
                  apply-on-change="true"
                  hover-hint="Enable controller vibration when follow-through threshold is met"/>

  <slider-setting text="Vibration Strength"
                  value="follow-through-strength"
                  min="0.1"
                  max="1.0"
                  increment="0.1"
                  apply-on-change="true"
                  hover-hint="Vibration strength when follow-through (30pts) threshold is reached"/>

  <horizontal>
    <text text="Visual Feedback" font-size="4"/>
  </horizontal>

  <toggle-setting text="Show Trajectory Line"
                  value="show-trajectory"
                  apply-on-change="true"
                  hover-hint="Show a line from each saber to its nearest matching note"/>

  <slider-setting text="Center Accuracy Target"
                  value="center-accuracy-target"
                  min="1"
                  max="15"
                  increment="1"
                  apply-on-change="true"
                  hover-hint="Sphere size at note center shows the zone for this many center accuracy points (15=smallest, 1=largest)"/>

  <horizontal>
    <text text="Note Grid Guide" font-size="4"/>
  </horizontal>

  <toggle-setting text="Show Note Grid"
                  value="show-note-grid"
                  apply-on-change="true"
                  hover-hint="Show semi-transparent cubes at each of the 12 note positions at cut depth"/>

  <slider-setting text="Note Grid Opacity"
                  value="note-grid-alpha"
                  min="0.01"
                  max="0.3"
                  increment="0.01"
                  apply-on-change="true"
                  hover-hint="Opacity of note grid cubes and trajectory sphere axis lines (0.01=barely visible, 0.3=semi-transparent)"/>

  <toggle-setting text="Link RhythmMarker Z Offset"
                  value="link-rhythm-marker-z"
                  apply-on-change="true"
                  hover-hint="When enabled and FaraRhythmMarker is installed, uses its Z offset for grid depth. Otherwise uses Z=0.5"/>

  <toggle-setting text="Debug Position Log"
                  value="note-grid-debug-log"
                  apply-on-change="true"
                  hover-hint="Log grid cube and note X/Y/Z coordinates to file for debugging"/>
</settings-container>
