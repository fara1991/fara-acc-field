<settings-container>
  <horizontal>
    <text text="FaraAccSupporter Settings" font-size="5" align="Center"/>
  </horizontal>

  <toggle-setting text="Enabled"
                  value="enabled"
                  apply-on-change="true"
                  hover-hint="Enable or disable the acc supporter mod"/>

  <horizontal>
    <text text="Pre-Swing Feedback (70pts)" font-size="4"/>
  </horizontal>

  <toggle-setting text="Note Glow"
                  value="pre-swing-glow"
                  apply-on-change="true"
                  hover-hint="Glow the target note when pre-swing (70pts) threshold is reached"/>

  <horizontal>
    <text text="Follow-Through Feedback (30pts)" font-size="4"/>
  </horizontal>

  <toggle-setting text="Vibration Enabled"
                  value="vibration-enabled"
                  apply-on-change="true"
                  hover-hint="Enable controller vibration when follow-through threshold is met"/>

  <slider-setting text="Vibration Strength"
                  value="follow-through-strength"
                  min="0.1"
                  max="1.0"
                  increment="0.1"
                  apply-on-change="true"
                  hover-hint="Vibration strength when follow-through (30pts) threshold is reached"/>

  <horizontal>
    <text text="Visual Feedback" font-size="4"/>
  </horizontal>

  <toggle-setting text="Show Trajectory Line"
                  value="show-trajectory"
                  apply-on-change="true"
                  hover-hint="Show a line from each saber to its nearest matching note (TD/TI aware)"/>
</settings-container>
