<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <OutputType>Library</OutputType>
        <AssemblyName>FaraAccField</AssemblyName>
        <RootNamespace>FaraAccField</RootNamespace>
        <Version>1.0.0</Version>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    </PropertyGroup>

    <PropertyGroup>
        <BeatSaberDir_1_29_1>$(USERPROFILE)\BSManager\BSInstances\1.29.1</BeatSaberDir_1_29_1>
        <BeatSaberDir_1_40_8>$(USERPROFILE)\BSManager\BSInstances\1.40.8</BeatSaberDir_1_40_8>
        <BSVersion Condition="'$(BSVersion)' == ''">1.29.1</BSVersion>
        <CIBuild Condition="'$(CIBuild)' == ''">false</CIBuild>
        <!-- Local build: use Beat Saber installation -->
        <BeatSaberDir Condition="'$(CIBuild)' != 'true' AND '$(BSVersion)' == '1.29.1'">$(BeatSaberDir_1_29_1)</BeatSaberDir>
        <BeatSaberDir Condition="'$(CIBuild)' != 'true' AND '$(BSVersion)' == '1.40.8'">$(BeatSaberDir_1_40_8)</BeatSaberDir>
        <!-- CI build: use Refs folder -->
        <BeatSaberDir Condition="'$(CIBuild)' == 'true'">$(ProjectDir)Refs\$(BSVersion)</BeatSaberDir>
        <LocalRefsDir>$(ProjectDir)Libs</LocalRefsDir>
        <!-- FaraRhythmMarker: search current version first, fallback to the other -->
        <FaraRhythmMarkerDll Condition="Exists('$(BeatSaberDir)\Plugins\FaraRhythmMarker.dll')">$(BeatSaberDir)\Plugins\FaraRhythmMarker.dll</FaraRhythmMarkerDll>
        <FaraRhythmMarkerDll Condition="'$(FaraRhythmMarkerDll)' == '' AND Exists('$(BeatSaberDir_1_40_8)\Plugins\FaraRhythmMarker.dll')">$(BeatSaberDir_1_40_8)\Plugins\FaraRhythmMarker.dll</FaraRhythmMarkerDll>
        <FaraRhythmMarkerDll Condition="'$(FaraRhythmMarkerDll)' == '' AND Exists('$(BeatSaberDir_1_29_1)\Plugins\FaraRhythmMarker.dll')">$(BeatSaberDir_1_29_1)\Plugins\FaraRhythmMarker.dll</FaraRhythmMarkerDll>
        <!-- CustomNotes: accessed via reflection at runtime (no compile-time reference) -->
    </PropertyGroup>

    <PropertyGroup Condition="'$(BSVersion)' == '1.29.1'">
        <DefineConstants>$(DefineConstants);BS_1_29_1</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(BSVersion)' == '1.40.8'">
        <DefineConstants>$(DefineConstants);BS_1_40_8</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="FaraAccField.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <!-- BSIPA -->
        <Reference Include="IPA.Loader">
            <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\IPA.Loader.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <!-- Beat Saber Core -->
        <Reference Include="Main">
            <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\Main.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="GameplayCore">
            <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\GameplayCore.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Core">
            <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\Core.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="BeatmapCore">
            <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\BeatmapCore.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="HMLib">
            <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\HMLib.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="HMUI">
            <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\HMUI.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <!-- BeatSaber.ViewSystem (1.40.8+: FlowCoordinator/ViewController moved here) -->
        <Reference Include="BeatSaber.ViewSystem" Condition="'$(BSVersion)' == '1.40.8'">
            <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\BeatSaber.ViewSystem.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <!-- Unity -->
        <Reference Include="UnityEngine">
            <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.UI">
            <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.UI.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.UIModule">
            <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.UIModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.XRModule">
            <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.XRModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.PhysicsModule">
            <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.TextRenderingModule">
            <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.TextMeshPro">
            <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\Unity.TextMeshPro.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <!-- Zenject -->
        <Reference Include="Zenject">
            <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\Zenject.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Zenject-usage">
            <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\Zenject-usage.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <!-- Harmony -->
        <Reference Include="0Harmony">
            <HintPath>$(BeatSaberDir)\Libs\0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <!-- SiraUtil -->
        <Reference Include="SiraUtil">
            <HintPath>$(BeatSaberDir)\Plugins\SiraUtil.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <!-- BSML for UI -->
        <Reference Include="BSML">
            <HintPath>$(BeatSaberDir)\Plugins\BSML.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <!-- FaraRhythmMarker (optional dependency, searched across BS versions) -->
        <Reference Include="FaraRhythmMarker" Condition="'$(FaraRhythmMarkerDll)' != ''">
            <HintPath>$(FaraRhythmMarkerDll)</HintPath>
            <Private>false</Private>
        </Reference>

        <!-- CustomNotes: accessed via reflection only (no compile-time reference needed) -->
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Views\SettingsView.bsml"/>
        <EmbeddedResource Include="Views\ModifierWarningView.bsml"/>
        <EmbeddedResource Include="manifest.$(BSVersion).json" Condition="Exists('manifest.$(BSVersion).json')">
            <LogicalName>$(RootNamespace).manifest.json</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="manifest.json" Condition="!Exists('manifest.$(BSVersion).json')">
            <LogicalName>$(RootNamespace).manifest.json</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <!-- Copy to Plugins folder after build -->
    <Target Name="CopyToPlugins" AfterTargets="Build">
        <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(BeatSaberDir)\Plugins"/>
    </Target>

    <!-- After building the default version (1.29.1), also build for 1.40.8 -->
    <Target Name="BuildSecondVersion" AfterTargets="CopyToPlugins"
            Condition="'$(BSVersion)' == '1.29.1' AND '$(SecondBuild)' != 'true'">
        <MSBuild Projects="$(MSBuildProjectFullPath)"
                 Properties="BSVersion=1.40.8;SecondBuild=true" />
    </Target>

    <!-- Create release ZIP: dotnet build /p:CreateRelease=true -->
    <Target Name="CreateReleaseZip" AfterTargets="BuildSecondVersion"
            Condition="'$(CreateRelease)' == 'true' AND '$(SecondBuild)' != 'true'">
        <PropertyGroup>
            <_ReleaseDir>$(ProjectDir)..\release</_ReleaseDir>
            <_StagingDir>$(_ReleaseDir)\staging</_StagingDir>
            <_ZipFileName>FaraAccField_v$(Version).zip</_ZipFileName>
        </PropertyGroup>

        <RemoveDir Directories="$(_StagingDir)" />
        <MakeDir Directories="$(_StagingDir)\1.29.1" />
        <MakeDir Directories="$(_StagingDir)\1.40.8" />

        <Copy SourceFiles="$(BeatSaberDir_1_29_1)\Plugins\$(AssemblyName).dll"
              DestinationFolder="$(_StagingDir)\1.29.1" />
        <Copy SourceFiles="$(BeatSaberDir_1_40_8)\Plugins\$(AssemblyName).dll"
              DestinationFolder="$(_StagingDir)\1.40.8" />
        <Copy SourceFiles="$(ProjectDir)..\SETTINGS_GUIDE.md"
              DestinationFolder="$(_StagingDir)" />

        <Delete Files="$(_ReleaseDir)\$(_ZipFileName)" Condition="Exists('$(_ReleaseDir)\$(_ZipFileName)')" />
        <ZipDirectory SourceDirectory="$(_StagingDir)"
                      DestinationFile="$(_ReleaseDir)\$(_ZipFileName)" />
        <RemoveDir Directories="$(_StagingDir)" />

        <Message Importance="high" Text="Release ZIP created: $(_ReleaseDir)\$(_ZipFileName)" />
    </Target>

</Project>
