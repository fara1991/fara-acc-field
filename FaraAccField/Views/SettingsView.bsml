<settings-container>
  <horizontal>
    <text text="FaraAccField Settings" font-size="5" align="Center"/>
  </horizontal>

  <horizontal bg='panel-top' pad='2'>
    <text text="~common-header" font-size="4" color="#B060E0" align="Center"/>
  </horizontal>

  <dropdown-list-setting text="Language"
                         value="language"
                         options="language-options"
                         apply-on-change="true"
                         hover-hint="~language-hint"/>

  <toggle-setting text="~enabled-text"
                  value="enabled"
                  apply-on-change="true"
                  hover-hint="~enabled-hint"/>

  <toggle-setting text="~debug-log-text"
                  value="notes-grid-debug-log"
                  apply-on-change="true"
                  hover-hint="~debug-log-hint"/>

  <horizontal bg='panel-top' pad='2'>
    <text text="~preswing-header" font-size="4" color="#B060E0" align="Center"/>
  </horizontal>

  <toggle-setting text="~notes-glow-text"
                  value="pre-swing-glow"
                  apply-on-change="true"
                  hover-hint="~notes-glow-hint"/>

  <horizontal bg='panel-top' pad='2'>
    <text text="~visual-header" font-size="4" color="#B060E0" align="Center"/>
  </horizontal>

  <toggle-setting text="~show-trajectory-text"
                  value="show-trajectory"
                  apply-on-change="true"
                  hover-hint="~show-trajectory-hint"/>

  <toggle-setting text="~show-sphere-text"
                  value="show-center-sphere"
                  apply-on-change="true"
                  hover-hint="~show-sphere-hint"/>

  <slider-setting id="center-accuracy-slider"
                  text="~center-accuracy-text"
                  value="center-accuracy-target"
                  min="1"
                  max="15"
                  increment="1"
                  apply-on-change="true"
                  hover-hint="~center-accuracy-hint"/>

  <toggle-setting text="~show-axis-text"
                  value="show-axis-line"
                  apply-on-change="true"
                  hover-hint="~show-axis-hint"/>

  <slider-setting id="axis-length-slider"
                  text="~axis-length-text"
                  value="axis-line-length"
                  min="0.2"
                  max="1"
                  increment="0.01"
                  apply-on-change="true"
                  hover-hint="~axis-length-hint"/>

  <slider-setting id="axis-width-slider"
                  text="~axis-width-text"
                  value="axis-line-width"
                  min="0.01"
                  max="0.05"
                  increment="0.01"
                  apply-on-change="true"
                  hover-hint="~axis-width-hint"/>

  <toggle-setting text="~show-arrow-text"
                  value="show-arrow-indicator"
                  apply-on-change="true"
                  hover-hint="~show-arrow-hint"/>

  <horizontal bg='panel-top' pad='2'>
    <text text="~grid-header" font-size="4" color="#B060E0" align="Center"/>
  </horizontal>

  <toggle-setting text="~show-grid-text"
                  value="show-notes-grid"
                  apply-on-change="true"
                  hover-hint="~show-grid-hint"/>

  <slider-setting id="grid-opacity-slider"
                  text="~grid-opacity-text"
                  value="notes-grid-alpha"
                  min="0.01"
                  max="0.3"
                  increment="0.01"
                  apply-on-change="true"
                  hover-hint="~grid-opacity-hint"/>

  <toggle-setting text="~link-rhythm-text"
                  value="link-rhythm-marker-z"
                  apply-on-change="true"
                  hover-hint="~link-rhythm-hint"/>

  <dropdown-list-setting id="z-step-dropdown"
                         text="~z-step-text"
                         value="z-offset-step"
                         options="z-offset-step-options"
                         apply-on-change="true"
                         hover-hint="~z-step-hint"/>

  <slider-setting id="z-offset-slider"
                  text="~z-offset-text"
                  value="notes-grid-z-offset"
                  min="0"
                  max="2"
                  increment="~z-offset-step"
                  apply-on-change="true"
                  hover-hint="~z-offset-hint"/>
</settings-container>
